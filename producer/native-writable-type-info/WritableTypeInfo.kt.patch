+
+// A type adapter and a collection converter occupy independent fields. A
+// repeated non-null field remains a conflicting override, as before.
+private fun StaticData.Global.mergedWritableTypeInfo(value: Struct): Struct? {
+    require(type == value.type)
+    val addition = value.elements.single() as Struct
+    require(addition.elements.size == 4)
+    val previous = requireNotNull(LLVMGetAggregateElement(requireNotNull(getInitializer()), 0))
+    require(LLVMTypeOf(previous) == addition.type)
+    val merged = mutableListOf<ConstValue?>()
+    for ((index, incoming) in addition.elements.withIndex()) {
+        val existing = requireNotNull(LLVMGetAggregateElement(previous, index))
+        val incomingValue = incoming?.llvm
+        val incomingIsNull = incomingValue == null || LLVMIsNull(incomingValue) != 0
+        if (LLVMIsNull(existing) == 0 && !incomingIsNull) return null
+        merged.add(if (incomingIsNull) constValue(existing) else incoming)
+    }
+    return Struct(value.type, Struct(addition.type, merged))
 }
 
