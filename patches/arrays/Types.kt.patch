+private fun CType.containsNSObjectClass(): Boolean = when (this) {
+    CType.NSObjectClass -> true
+    is CType.Generic -> args.any { it.containsNSObjectClass() }
+    is CType.NullabilityAnnotated -> wrapped.containsNSObjectClass()
+    else -> false
+}
+
+private fun CType.carrierSwiftType(hashablePosition: Boolean = false): String = when {
+    hashablePosition && (this == CType.id || this == CType.NSObject || this == CType.NSError || this is CType.Generic) -> "Swift.AnyHashable"
+    this is CType.NSArray -> "Swift.Array<${args[0].carrierSwiftType()}>"
+    this is CType.NSSet -> "Swift.Set<${args[0].carrierSwiftType(hashablePosition = true)}>"
+    this is CType.NSDictionary -> "Swift.Dictionary<${args[0].carrierSwiftType(hashablePosition = true)}, ${args[1].carrierSwiftType()}>"
+    this is CType.NullabilityAnnotated -> wrapped.carrierSwiftType(hashablePosition) + "?"
+    else -> toSwiftTypeName()
+}
