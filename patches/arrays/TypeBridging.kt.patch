+private fun BidirectionalBridge.hasNativeCarrier(): Boolean = this is AsObjCBridged && requiresNativeCarrier
+private fun BidirectionalBridge.collectionValueType(typeNamer: SirTypeNamer): String =
+    if (this is AsObjCBridged) nativeValueType(typeNamer) else kotlinReverseParameterTypeFqName(typeNamer)
+private fun BidirectionalBridge.collectionStoredType(typeNamer: SirTypeNamer): String =
+    if (this is AsObjCBridged) nativeStoredType(typeNamer) else kotlinReverseParameterTypeFqName(typeNamer)
+private fun BidirectionalBridge.collectionSwiftType(typeNamer: SirTypeNamer): String =
+    if (this is AsObjCBridged) storedSwiftType(typeNamer) else typeNamer.swiftFqName(swiftType)
+private fun BidirectionalBridge.storeCollectionValue(typeNamer: SirTypeNamer, value: String): String =
+    if (this is AsObjCBridged) toNativeStored(typeNamer, value) else value
+private fun BidirectionalBridge.loadCollectionValue(typeNamer: SirTypeNamer, value: String): String =
+    if (this is AsObjCBridged) fromNativeStored(typeNamer, value) else value
+
+context(session: SirSession)
+private fun callbackKotlinType(typeNamer: SirTypeNamer, type: SirType): String {
+    if (type is SirNominalType && type.typeDeclaration == SirSwiftModule.optional) {
+        return callbackKotlinType(typeNamer, type.typeArguments.single()) + "?"
+    }
+    if (type is SirFunctionalType) {
+        val arguments = type.contextTypes + type.parameterTypes + type.returnType
+        val prefix = if (type.isAsync) "kotlin.coroutines.Suspend" else ""
+        return "${prefix}Function${arguments.size - 1}<${arguments.joinToString { callbackKotlinType(typeNamer, it) }}>"
+    }
+    val bridge = bridgeType(type)
+    return when (bridge) {
+        is AsStringArray -> bridge.kotlinReverseParameterTypeFqName(typeNamer)
+        is AsObjCBridged -> if (bridge.requiresNativeCarrier) bridge.nativeValueType(typeNamer) else typeNamer.kotlinFqName(type, SirTypeNamer.KotlinNameType.PARAMETRIZED)
+        else -> typeNamer.kotlinFqName(type, SirTypeNamer.KotlinNameType.PARAMETRIZED)
+    }
+}
+
+context(session: SirSession)
+private fun incomingCollectionSwiftValue(
+    bridge: BidirectionalBridge,
+    typeNamer: SirTypeNamer,
+    value: String,
+    hashablePosition: Boolean = false,
+): String {
+    val type = bridge.cType
+    val erasedKey = hashablePosition && (type == CType.id || type == CType.NSObject || type == CType.NSError || type is CType.Generic)
+    val raw = if (erasedKey) "$value.base" else value
+    fun checked(target: String): String = "({ () -> $target in guard let __typed = $raw as? $target else { preconditionFailure(\"Unexpected Objective-C collection payload\") }; return __typed })()"
+    if (erasedKey && bridge is AsObjCBridged && bridge.requiresNativeCarrier) {
+        return bridge.inSwiftSources.kotlinToSwift(typeNamer, checked(bridge.storedSwiftType(typeNamer)))
+    }
+    val converted = bridge.inSwiftSources.kotlinToSwift(typeNamer, raw)
+    if (converted != raw || !(erasedKey || type == CType.id || type == CType.NSObject)) return converted
+    if (bridge is AsObjCBridgedOptional && bridge.swiftType is SirNominalType && (bridge.swiftType as SirNominalType).typeDeclaration == SirSwiftModule.optional) {
+        val target = typeNamer.swiftFqName(bridge.swiftType)
+        val wrapped = typeNamer.swiftFqName((bridge.swiftType as SirNominalType).typeArguments.single())
+        return "({ () -> $target in if $raw is NSNull { return nil }; guard let __typed = $raw as? $wrapped else { preconditionFailure(\"Unexpected Objective-C collection payload\") }; return __typed })()"
+    }
+    return checked(typeNamer.swiftFqName(bridge.swiftType))
+}
